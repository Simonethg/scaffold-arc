# ── Arc network endpoints ────────────────────────────────────────────────
# Public defaults work out of the box. Swap in a provider URL (Alchemy,
# QuickNode, Blockdaemon, dRPC) if you hit rate limits.
ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.io"
ARC_MAINNET_RPC_URL="https://rpc.mainnet.arc.io"

# ── Deployer key ─────────────────────────────────────────────────────────
# NEVER commit a funded key. Gas on Arc is paid in USDC (native, 18 decimals).
# Testnet USDC: https://faucet.circle.com (select Arc Testnet).
PRIVATE_KEY=

# ── Contract verification (Blockscout) ───────────────────────────────────
BLOCKSCOUT_VERIFIER_URL_TESTNET="https://testnet.arcscan.app/api/"
BLOCKSCOUT_VERIFIER_URL_MAINNET="https://explorer.arc.io/api/"
